# ===== SERVER =====
PORT=3000

# ===== DISCORD =====
# ID твоего Discord-сервера (ПКМ по серверу -> Copy Server ID, нужен Developer Mode)
GUILD_ID=
# Токен бота: https://discord.com/developers/applications -> Bot -> Token
# Боту нужны права на чтение Scheduled Events сервера.
DISCORD_BOT_TOKEN=

# ===== CACHE =====
# Сколько миллисекунд хранить ответ Discord API в памяти
CACHE_TTL_MS=60000
